{
  "name": "osu-4k-dual-downloader",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "OSU!Manager! - osu!mania dual-client (stable + lazer) beatmap downloader, 3D book archive & Constructivist music station",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').copyFileSync('electron/preload.cjs','dist-electron/preload.cjs')\"",
    "build": "npm run build:web && npm run build:server && npm run build:electron",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:pack": "npm run build && electron-builder --win dir",
    "electron:dist": "npm run build && electron-builder --win dir zip portable nsis"
  },
  "build": {
    "appId": "com.osumapdownloader.mania4k",
    "productName": "osu-manager",
    "asar": true,
    "asarUnpack": [
      "build/**"
    ],
    "afterPack": "./scripts/apply-exe-icon.mjs",
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "executableName": "osu-manager",
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "artifactName": "osu-manager-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSU Manager",
      "uninstallDisplayName": "OSU!Manager! ${version}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "packElevateHelper": false,
      "differentialPackage": false,
      "artifactName": "osu-manager-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "osu-manager-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "undici": "^7.10.0"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
